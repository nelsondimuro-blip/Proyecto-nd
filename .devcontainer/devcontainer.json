{
  "name": "Bandeja ND",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && npm install",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Panel web", "onAutoForward": "openBrowser" },
    "8080": { "label": "Gateway de WhatsApp", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
