# ---------------------------------------------------------------------------
# Supabase (compartido por web y gateway)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo en el servidor. NUNCA exponer en el navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Gateway de WhatsApp
# ---------------------------------------------------------------------------
# URL interna del servicio gateway (la web lo llama desde el servidor)
GATEWAY_URL=http://localhost:8080
# Secreto compartido entre la web y el gateway. Generar con: openssl rand -hex 32
GATEWAY_SHARED_SECRET=cambiame-por-un-secreto-largo

PORT=8080
LOG_LEVEL=info
# Nombre que ve el usuario en "Dispositivos vinculados" de WhatsApp
WA_BROWSER_NAME=Proyecto ND Inbox
